---
import { getCollection } from 'astro:content'
import BlogLayout from '../../layouts/BlogLayout.astro'

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate - a.data.pubDate
)
const fmt = new Intl.DateTimeFormat('ru-RU', { day: 'numeric', month: 'long', year: 'numeric' })
---
<BlogLayout
  title="Блог — AI Trainer"
  description="Про самостоятельные тренировки в зале, программы и то, как мы делаем AI-тренера."
>
  <h1>Блог</h1>
  <p style="color: var(--fg-2);">
    Про самостоятельные тренировки, программы и то, как мы делаем AI-тренера.
  </p>
  <ul class="posts">
    {posts.map((post) => (
      <li>
        <a href={`/blog/${post.id}/`} class="post-card">
          <span class="post-meta">{fmt.format(post.data.pubDate)}</span>
          <span class="post-title">{post.data.title}</span>
          <span class="post-desc">{post.data.description}</span>
        </a>
      </li>
    ))}
  </ul>
</BlogLayout>

<style>
  .posts { list-style: none; padding: 0; margin: 32px 0 0; display: grid; gap: 16px; }
  .post-card {
    display: grid; gap: 6px;
    padding: 20px 22px; border-radius: 16px;
    background: var(--surface-0); border: 1px solid var(--border-subtle);
    text-decoration: none;
    transition: border-color 0.15s;
  }
  .post-card:hover { border-color: var(--border-accent); }
  .post-title { color: var(--fg-1); font-size: 19px; font-weight: 650; line-height: 1.3; }
  .post-desc { color: var(--fg-2); font-size: 14px; }
</style>
