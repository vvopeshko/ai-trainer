// Prisma schema для AI Trainer.
// Подробности и обоснование — в /ARCHITECTURE.md §4.
//
// ⚠️  ПРАВИЛА РАБОТЫ СО СХЕМОЙ (см. §5.2 ARCHITECTURE.md):
//    - Только `prisma db push`, без миграций.
//    - NOT NULL колонки на существующую таблицу — сначала ALTER TABLE ... DEFAULT '...' вручную.
//    - Rename/delete колонок — только ручным SQL.
//    - Перед `db push` на проде — зафиксировать timestamp (для PITR-отката).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════
// User — создаётся через telegramAuth middleware
// ═══════════════════════════════════════════════
model User {
  id            String   @id @default(uuid())
  // Nullable: web-only юзеры (Better Auth) не имеют telegramId.
  // Несколько NULL в unique-колонке Postgres допустимы.
  telegramId    BigInt?  @unique
  firstName     String   // BA-поле name маппится сюда (fields.name в auth/index.js)
  lastName      String?
  username      String?
  languageCode  String?
  photoUrl      String?  // BA-поле image маппится сюда
  timezone      String?

  // Web-auth (Better Auth). ⚠️ email обязан оставаться String? — у TG-юзеров
  // email нет. BA-codegen генерит String NOT NULL: после любого
  // `@better-auth/cli generate` править руками (ловится parity-тестом).
  email         String?  @unique
  emailVerified Boolean  @default(false)

  firstSeenAt   DateTime @default(now())
  lastSeenAt    DateTime @default(now())
  sessionsCount Int      @default(0)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  profile                UserProfile?
  programs               Program[]
  workouts               Workout[]
  chatMessages           ChatMessage[]
  machineIdentifications MachineIdentification[]
  analyticsEvents        AnalyticsEvent[]
  exerciseSettings       UserExerciseSettings[]
  notificationLogs       NotificationLog[]
  pendingChatContexts    PendingChatContext[]
  insights               Insight[]
  planOverrides          WorkoutPlanOverride[]
  llmUsage               LlmUsage[]
  sessions               Session[]
  accounts               Account[]
  pushSubscriptions      PushSubscription[]
}

// ═══════════════════════════════════════════════
// Session / Account / Verification / RateLimit — таблицы Better Auth
// (web-авторизация, см. product/ARCHITECTURE_WEB_AUTH.md §3.2).
// Поля — ровно по требованиям BA 1.6 (getAuthTables). Канон Telegram-идентичности —
// User.telegramId: записи в Account для Telegram НЕ создаются.
// ═══════════════════════════════════════════════
model Session {
  id        String   @id @default(uuid())
  token     String   @unique // opaque session-токен — клиент носит как Bearer
  expiresAt DateTime // sliding: BA продлевает при активности (updateAge)
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Account {
  id                    String    @id @default(uuid())
  providerId            String // 'credential' (email+пароль) | 'google' | 'yandex' | ...
  accountId             String // ID юзера у провайдера; для credential = userId
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  password              String? // scrypt-хеш (только providerId='credential')
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model Verification {
  id         String   @id @default(uuid())
  identifier String // verify-email, reset-password, OAuth state — всё здесь
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// Встроенный rate limiting BA (rateLimit.storage='database' — переживает рестарт Railway)
model RateLimit {
  id          String  @id @default(uuid())
  key         String?
  count       Int?
  lastRequest BigInt?

  @@index([key])
}

// ═══════════════════════════════════════════════
// NotificationJob — durable-очередь уведомлений (см. product/NOTIFICATIONS.md).
//
// Planner (минутный cron) идемпотентно создаёт jobs (createMany skipDuplicates
// по @@unique), worker атомарно клеймит (optimistic CAS по status+lockedAt),
// рендерит (LLM-текст сохраняется — retry не зовёт LLM повторно) и доставляет
// в Telegram или Web Push. Заменяет прямую отправку для weekly/post_workout;
// NotificationLog остаётся мостом идемпотентности с legacy-шедулером.
//
// recipientKey полиморфный ('user:<uuid>') — без FK, jobs переживают удаление
// юзера как аудит; чистятся retention'ом.
// ═══════════════════════════════════════════════
model NotificationJob {
  id            String    @id @default(uuid())
  type          String // 'weekly' | 'post_workout' | ...
  channel       String // 'telegram' | 'web_push'
  recipientKey  String // 'user:<uuid>'
  periodKey     String // weekKey | workoutId — идемпотентный ключ периода/события
  timezone      String?
  scheduledFor  DateTime  @default(now()) // ожидаемое время доставки (UTC)
  status        String    @default("pending") // pending|rendering|sending|retry|sent|failed|skipped
  payload       Json? // snapshot + delivery metadata (title, url, buttons)
  renderedText  String?   @db.Text // готовый текст — retry не меняет и не пересчитывает
  attempts      Int       @default(0)
  maxAttempts   Int       @default(6)
  nextAttemptAt DateTime  @default(now())
  lockedAt      DateTime?
  lockedBy      String?
  sentAt        DateTime?
  providerRef   String? // telegram message_id | 'push:<count>'
  errorCode     String?
  errorMessage  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Канал НЕ входит в unique: смена канала внутри периода не создаёт второй job
  @@unique([type, recipientKey, periodKey])
  @@index([status, nextAttemptAt, scheduledFor])
  @@index([recipientKey, createdAt])
}

// ═══════════════════════════════════════════════
// PushSubscription — Web Push подписки PWA (несколько устройств на юзера).
// endpoint уникален глобально; 404/410 от push service → запись удаляется.
// ═══════════════════════════════════════════════
model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
}

// ═══════════════════════════════════════════════
// UserProfile — анкета из онбординга
// ═══════════════════════════════════════════════
model UserProfile {
  id              String          @id @default(uuid())
  userId          String          @unique
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  goal            Goal
  experienceLevel ExperienceLevel
  gender          Gender?
  age             Int?
  weightKg        Float?
  heightCm        Float?

  // 0=ВС..6=СБ
  availableDays   Int[]           @default([])
  sessionsPerWeek Int?

  // Теги: ['lower_back', 'knee', ...] / ['barbell', 'machine', ...]
  constraints     String[]        @default([])
  equipment       String[]        @default([])

  // Настройки уведомлений тренера: { postWorkout, weekly, monthly, reminders, records }.
  // null = дефолт «всё включено» (см. src/scheduler).
  notificationsJson Json?

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

enum Goal {
  weight_loss
  muscle_gain
  strength
  tone
  endurance
  general_fitness
}

enum ExperienceLevel {
  beginner
  intermediate
  advanced
}

enum Gender {
  male
  female
  other
}

// ═══════════════════════════════════════════════
// Exercise — глобальная библиотека (один список для всех)
// Заполняется через server/scripts/seedExercises.js
// ═══════════════════════════════════════════════
model Exercise {
  id               String             @id @default(uuid())
  slug             String             @unique // 'barbell-bench-press'

  nameRu           String
  nameEn           String?

  description      String?            @db.Text
  instructions     String?            @db.Text
  typicalMistakes  String?            @db.Text

  primaryMuscles   String[]           @default([]) // ['chest', 'triceps']
  secondaryMuscles String[]           @default([])
  equipment        String[]           @default([]) // ['barbell', 'bench']

  difficulty       ExerciseDifficulty @default(beginner)
  category         ExerciseCategory   @default(compound)

  youtubeUrl       String?
  imageUrl         String?
  gifUrl           String?            // анимированная GIF-демонстрация (ExerciseDB OSS, кэшируется при seed)
  videos           Json?              // [{url, title, channel, source: 'youtube', lang: 'ru'|'en'}]

  // Синонимы для подбора по распознаванию тренажёра и текстового поиска.
  aliases          String[]           @default([])

  // Откуда пришло упражнение: seed (из базы), ai_generated (auto-created при resolve), user_created (юзер добавил).
  source           ExerciseSource     @default(seed)

  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  workoutSets      WorkoutSet[]

  @@index([category])
  @@index([aliases], type: Gin) // поиск по массиву алиасов (unnest/@> в exerciseResolver)
}

enum ExerciseDifficulty {
  beginner
  intermediate
  advanced
}

enum ExerciseCategory {
  compound
  isolation
  cardio
  warmup
  stretch
  mobility
}

enum ExerciseSource {
  seed           // из seed-скрипта (Free Exercise DB + обогащение)
  ai_generated   // auto-created через exerciseResolver при LLM resolve
  user_created   // юзер добавил вручную (будущее)
}

// ═══════════════════════════════════════════════
// Program — сгенерированная программа тренировок
// planJson: { weeks: [{ days: [{ title, exercises: [{ exerciseId, sets, reps, restSec, notes }] }] }] }
// ═══════════════════════════════════════════════
model Program {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  name             String
  description      String?
  durationWeeks    Int       @default(4)
  isActive         Boolean   @default(false) // одна активная на юзера
  planJson         Json
  guidelines       Json? // методические указания: volumeTargets, progression, deload, constraints, nutrition, schedule

  generatedByModel String? // 'claude-*' — для аналитики качества

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  workouts         Workout[]
  planOverrides    WorkoutPlanOverride[]

  @@index([userId, isActive])
}

// ═══════════════════════════════════════════════
// Workout — реальная тренировка (сессия в зале)
// ═══════════════════════════════════════════════
model Workout {
  id              String       @id @default(uuid())
  userId          String
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  programId       String?
  program         Program?     @relation(fields: [programId], references: [id], onDelete: SetNull)
  programDayIndex Int? // индекс дня из planJson

  startedAt       DateTime     @default(now())
  finishedAt      DateTime?
  pausedAt        DateTime?                  // timestamp начала текущей паузы (null = не на паузе)
  totalPausedMs   Int          @default(0)   // суммарное время на паузе в мс

  feltRating      Int? // 1..5 — как прошла тренировка
  notes           String?

  sets            WorkoutSet[]

  @@index([userId, startedAt])
  @@index([userId, finishedAt]) // горячий путь: recent/stats/reminder фильтруют по finishedAt
  @@index([programId])          // джойны/фильтры тренировок по программе
}

// ═══════════════════════════════════════════════
// WorkoutSet — один подход в упражнении
// ═══════════════════════════════════════════════
model WorkoutSet {
  id            String   @id @default(uuid())
  workoutId     String
  workout       Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)

  exerciseId    String
  exercise      Exercise @relation(fields: [exerciseId], references: [id])

  exerciseOrder Int      @default(0) // порядок упражнения в тренировке
  setOrder      Int      @default(0) // порядок подхода в упражнении

  weightKg      Float?
  reps          Int
  rpe           Float? // Rate of Perceived Exertion 1..10
  isWarmup      Boolean  @default(false)
  notes         String?

  completedAt   DateTime @default(now())

  @@index([workoutId])
  @@index([exerciseId])
}

// ═══════════════════════════════════════════════
// ChatMessage — история диалога с AI-тренером
// ═══════════════════════════════════════════════
model ChatMessage {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  role         ChatRole
  content      String   @db.Text
  imageUrl     String? // если сообщение было с фото

  model        String? // какой LLM ответил
  tokensInput  Int?
  tokensOutput Int?

  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
}

enum ChatRole {
  user
  assistant
  system
}

// ═══════════════════════════════════════════════
// MachineIdentification — лог распознаваний тренажёра по фото
// Нужен для: метрик фичи, улучшения промпта, потенциального датасета.
// ═══════════════════════════════════════════════
model MachineIdentification {
  id                  String   @id @default(uuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  imageUrl            String // R2 URL
  recognizedName      String?
  confidence          Float? // 0..1

  // [{ exerciseId, name, reasoning }]
  suggestedExercises  Json     @default("[]")

  userConfirmed       Boolean? // выбрал ли юзер упражнение
  confirmedExerciseId String?

  model               String?

  createdAt           DateTime @default(now())

  @@index([userId, createdAt])
}

// ═══════════════════════════════════════════════
// UserExerciseSettings — per-exercise settings (unit, step, presets)
// Synced from client localStorage for cross-device persistence.
// ═══════════════════════════════════════════════
model UserExerciseSettings {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // ⚠️ exerciseSlug — денормализованная ссылка на Exercise.slug БЕЗ FK.
  // Осознанно: dedupeExercises.js переименовывает/сливает slug'и, а FK при
  // rename осиротил бы настройки (или заблокировал бы дедуп). Инвариант
  // поддерживается на уровне приложения; настройки с «мёртвым» slug безвредны
  // (просто не найдут упражнение и будут пересозданы по факту использования).
  exerciseSlug String

  preset       String?
  unit         String   @default("kg")
  step         Float    @default(2.5)
  stepUnit     String   @default("kg")
  minWeight    Float    @default(0)
  maxWeight    Float    @default(500)
  type         String   @default("reps")

  updatedAt    DateTime @updatedAt

  @@unique([userId, exerciseSlug])
  @@index([userId])
}

// ═══════════════════════════════════════════════
// AnalyticsEvent — fire-and-forget события (utils/analytics.js)
// ═══════════════════════════════════════════════
model AnalyticsEvent {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  event     String // 'workout_logged', 'exercise_photo_taken', ...
  payload   Json?

  createdAt DateTime @default(now())

  @@index([event, createdAt])
  @@index([userId, createdAt])
}

// ═══════════════════════════════════════════════
// NotificationLog — идемпотентность проактивных сообщений тренера.
// Шедулер (src/scheduler) перед отправкой делает create; дубль (@@unique)
// = сообщение уже отправлено в этом периоде → пропуск. Защищает от повторов
// при рестарте процесса (Railway).
// ═══════════════════════════════════════════════
model NotificationLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  kind      String // 'post_workout' | 'weekly' | 'monthly' | 'reminder' | 'checkin' | ...
  periodKey String // '2026-W24' | '2026-06' | '2026-06-13' | workoutId — гранулярность зависит от kind

  sentAt    DateTime @default(now())

  @@unique([userId, kind, periodKey])
  @@index([userId, kind])
}

// ═══════════════════════════════════════════════
// PendingChatContext — handoff контекста из мини-аппа в чат-бота (фаза 2.2)
//
// Юзер жмёт «Спросить про упражнение/программу» в мини-аппе → POST /chat/context
// создаёт запись → openTelegramLink открывает бота. Бот при следующем сообщении
// подхватывает свежий (TTL ~10 мин) неиспользованный контекст и кладёт в system.
// consumedAt != null = уже подхвачен; createdAt — для TTL и выбора самого свежего.
// ═══════════════════════════════════════════════
model PendingChatContext {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  type       String // 'exercise' | 'program' | 'workout'
  refId      String? // exerciseId | programId | workoutId
  payload    Json? // снапшот-подсказка (напр. { name } для проактивного сообщения)

  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, createdAt])
}

// ═══════════════════════════════════════════════
// Insight — кэш ежедневного «замечания тренера» на Home (фаза 4.2).
//
// Генерируется лениво при первом запросе дня (не cron — юзер может не зайти).
// payload: { text: string|null, factType?: string } — null = за день инсайтов нет
// (кэшируем пустой, чтобы не пересчитывать). Один на юзера в день.
// ═══════════════════════════════════════════════
model Insight {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  date      String // 'YYYY-MM-DD' в TZ юзера
  payload   Json

  createdAt DateTime @default(now())

  @@unique([userId, date])
  @@index([userId])
}

// ═══════════════════════════════════════════════
// WorkoutPlanOverride — разовый оверрайд дня программы «только следующая
// тренировка» (рефайн через чат, фаза 5b).
//
// Чат-тренер по запросу «только на следующую тренировку ...» апсертит сюда
// переопределённый список упражнений дня. getNextWorkout/getActive подмешивают
// его поверх planJson; при финише тренировки оверрайд удаляется (consume),
// чтобы не «прилипать» к следующим циклам. Шаблон программы (Program.planJson)
// при этом не трогается.
// ═══════════════════════════════════════════════
model WorkoutPlanOverride {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  programId String
  program   Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  dayIndex  Int
  exercises Json // переопределённый список упражнений дня

  createdAt DateTime @default(now())

  @@unique([userId, programId, dayIndex])
  @@index([userId])
}

// ═══════════════════════════════════════════════
// LlmUsage — лог расхода токенов LLM с денежной оценкой (utils/llmUsage.js).
//
// Пишется fire-and-forget из llm.js при каждом вызове chat()/vision() с meta.
// costUsd — снимок по прайсу на момент вызова (см. utils/llmCost.js), ≈.
// onDelete: SetNull — суммы расхода переживают удаление юзера (как AnalyticsEvent).
// Читается командой /cost (services/aiTrainer/usageReport.js).
// ═══════════════════════════════════════════════
model LlmUsage {
  id           String   @id @default(uuid())
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  feature      String // 'chat' | 'program_generate' | 'program_import' | 'vision_machine' | 'post_workout' | 'weekly_summary' | 'daily_insight'
  model        String
  tokensInput  Int      @default(0)
  tokensOutput Int      @default(0)
  costUsd      Float    @default(0) // снимок по прайсу на момент вызова, ≈

  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([feature, createdAt])
}
