# Backend environment example.
# Скопируй в server/.env и заполни. НИКОГДА не коммить заполненный .env.

# ─── Инфраструктура ─────────────────────────────────────────────
# Neon Postgres URL (через https://neon.tech). PITR — обязателен.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

NODE_ENV=development
PORT=3001

# Разрешить dev_bypass авторизацию (только для локальной разработки!)
ALLOW_DEV_BYPASS=true

# ─── Telegram ───────────────────────────────────────────────────
# Получить через @BotFather → /newbot
BOT_TOKEN=
# BOT_DISABLED=1 — запуск без Telegraf-поллинга (локальные смоуки не конфликтуют
# с прод-ботом на том же токене; HMAC-валидация initData/виджета работает)
# BOT_DISABLED=

# Frontend URL (локально / прод). Можно несколько через запятую
# (кастомный домен + vercel.app); первый — канонический: на него строятся
# ссылки в письмах и OAuth-редиректы. Прод: https://gymwithai.me,https://<проект>.vercel.app
FRONTEND_URL=http://localhost:5173
# URL, который подставляется в Menu Button и inline-клавиатуру.
WEBAPP_URL=http://localhost:5173

# ─── AI ─────────────────────────────────────────────────────────
# Anthropic API key: https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Модель и лимит токенов для LLM-вызовов (опционально, defaults ниже)
# LLM_MODEL=claude-sonnet-4-6
# LLM_MAX_TOKENS=1024

# ─── Cloudflare R2 (фото тренажёров) ────────────────────────────
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=ai-trainer-photos
R2_ENDPOINT=

# ─── YouTube (опционально, для масштабирования) ──────────────────
# YouTube Data API v3 key. Пилот работает без него (через yt-search scraping).
# Понадобится при обогащении всей базы (924 шт.) — лимиты scraping'а не потянут.
# YOUTUBE_API_KEY=

# ─── Web-авторизация (Better Auth) — см. product/ARCHITECTURE_WEB_AUTH.md ───
# Без BETTER_AUTH_SECRET web-auth выключен целиком (Mini App работает как раньше).
# Сгенерировать: openssl rand -base64 48
BETTER_AUTH_SECRET=
# Активные web-провайдеры (через запятую). Поддерживаются: email, google, yandex.
# Провайдер работает только при заданных credentials.
AUTH_PROVIDERS=email
# Базовый URL API (для BA; локально — localhost, на Railway — публичный домен)
API_URL=http://localhost:3001
# Resend (письма верификации/сброса). Без ключа в dev (ALLOW_DEV_BYPASS=true)
# ссылки логируются в консоль сервера.
RESEND_API_KEY=
EMAIL_FROM=AI Trainer <noreply@example.com>
# OAuth (включаются добавлением в AUTH_PROVIDERS + credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# ─── Уведомления (durable-очередь + Web Push) — см. product/NOTIFICATIONS.md ───
# off = только legacy-шедулер | shadow = очередь планирует skipped-jobs (проверка
# без доставки), шлёт legacy | on = очередь доставляет, legacy weekly подавлен
NOTIFICATION_QUEUE=off
# Аварийная пауза доставки (planner продолжает копить jobs)
NOTIFICATION_WORKER=on
# NOTIFICATION_BATCH_SIZE=20
# NOTIFICATION_CONCURRENCY=5
# Web Push (VAPID). Сгенерировать: npx web-push generate-vapid-keys
# Без ключей web_push-канал выключен (уведомления только в Telegram).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:noreply@gymwithai.me

# ─── Сервисное ──────────────────────────────────────────────────
# Секрет для админ-эндпоинтов /api/v1/analytics/*
ANALYTICS_SECRET=change-me-to-random-string
# Твой telegramId (для будущих админ-фич)
ADMIN_TELEGRAM_ID=

# Evidence Console access (comma-separated User UUIDs or explicit tg:<telegramId>).
# Approvers can perform scientific/product approval; reviewers can edit and submit.
# Empty values fail closed: no evidence admin access.
EVIDENCE_REVIEWER_IDS=
EVIDENCE_APPROVER_IDS=
# Годовая цель тренировок (по умолчанию 208 = 4/нед × 52)
# ANNUAL_WORKOUT_TARGET=208

# ─── Биллинг (product/ARCHITECTURE_PAYMENTS.md) ──────────────────
# Фиче-флаги способов оплаты через запятую: stars,yookassa,tribute,paddle
# (паттерн AUTH_PROVIDERS). mock — только dev/тесты: мгновенная «оплата».
PAYMENT_PROVIDERS=
# Hard paywall: on = всё приложение за подпиской (requirePremium + гейт фронта
# + paywallGuard бота). Продажа работает и при off — включаются независимо.
PREMIUM_GATING=off
# Grace после конца оплаченного периода (лаги вебхуков/ретраи), часов
# BILLING_GRACE_HOURS=24
